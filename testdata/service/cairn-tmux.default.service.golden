# Managed by cairn host (workspace). Do not edit; run "cairn host ..."
[Unit]
Description=tmux server for cairn workspaces

[Service]
Type=forking
ExecStart=/usr/bin/env tmux -f /dev/null new-session -d -s cairn-base
ExecStartPost=/usr/bin/env tmux set -g exit-empty off
KillMode=control-group

[Install]
WantedBy=default.target
